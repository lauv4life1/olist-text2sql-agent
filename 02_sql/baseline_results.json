  "1": {
    "id": 1,
    "title": "总订单数 / 总成交额 / 客单价",
    "question": "平台一共成交了多少订单？总成交额是多少？平均每单多少钱？",
    "skill": "COUNT(DISTINCT) / SUM / 除法",
    "sql": "SELECT COUNT(DISTINCT order_id) AS total_orders, ROUND(SUM(payment_value), 2) AS gmv, ROUND(SUM(payment_value) / COUNT(DISTINCT order_id), 2) AS aov FROM order_payments",
    "row_count": 1,
    "rows": [
      {
        "total_orders": 99440,
        "gmv": 16008872.12,
        "aov": 160.99
      }
    ],
    "status": "ok"
  },
