# ============================================================
# 复制本文件为 .env 并填入真实值（.env 不要提交到 Git）
# ============================================================

# ---- MySQL（本机 3306 端口，库名 olist_ecommerce）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=olist_ecommerce

# ---- LLM（Phase 3 Text2SQL Agent 使用）----
# 兼容 OpenAI 协议的服务均可（智谱 GLM / DeepSeek / 通义千问 兼容模式）
# 智谱 GLM：BASE_URL = https://open.bigmodel.cn/api/paas/v4
#   MODEL = glm-4.7-flash（免费）或 glm-4.6（质量更好，全量测试约 ¥0.1~0.2）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.6
